{
  "name": "workspace-quote-pdf",
  "version": "0.1.0",
  "private": true,
  "description": "Google Sheets add-on that turns grouped line-item rows into branded quotation PDFs.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "demo": "tsx scripts/demo.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "clasp:login": "clasp login",
    "clasp:create": "clasp create --type sheets --title \"Workspace Quote PDF\"",
    "clasp:push": "npm run build && clasp push",
    "clasp:deploy": "npm run build && clasp push && clasp deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@google/clasp": "^3.1.0",
    "@types/google-apps-script": "^1.0.99",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
